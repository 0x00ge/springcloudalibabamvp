<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mvp</groupId>
        <artifactId>services</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>service-order-0</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- common：复用 ResultVO、UUIDv7、Dubbo API 接口等共享能力。 -->
        <dependency>
            <groupId>com.mvp</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- Nacos Config：读取订单服务环境配置。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Nacos Discovery：把订单服务注册到 Nacos，并为 Feign 提供服务发现。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- Spring MVC Web：提供秒杀下单和结果查询接口。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- OpenFeign：声明式调用 service-goods-0 完成库存预扣、回补和商品信息查询。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- LoadBalancer：Feign 通过 lb 协议从 Nacos 选择 goods 服务实例。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- MyBatis-Plus：秒杀订单 Mapper、ServiceImpl 的数据访问基础。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- dynamic-datasource：根据配置管理 master/slave 数据源。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL Driver：连接本地 master/slave MySQL 实例。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Redisson：提供分布式锁、用户防重标记和秒杀结果缓存所需的分布式对象，已包含 spring-data-redis。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- RocketMQ Spring Boot Starter：封装 RocketMQTemplate 生产者和 @RocketMQMessageListener 消费者，
             2.3.x 起支持 Proxy gRPC 模式（rocketmq.proxy.grpc-endpoints），当前使用 Proxy 连接 RocketMQ 集群。 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

</project>
