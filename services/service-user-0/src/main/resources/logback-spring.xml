<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 注册 Spring Boot 提供的 %clr 颜色转换器，否则自定义 logback 配置中无法识别 %clr(...)。 -->
    <conversionRule conversionWord="clr"
                    converterClass="org.springframework.boot.logging.logback.ColorConverter"/>

    <!-- 从 Spring 配置中读取应用名，用于区分不同服务的日志目录。 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="service-user-0"/>

    <property name="LOG_PATH" value="logs/${APP_NAME}"/>
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%thread]){faint} %clr(%logger{36}){cyan} - %msg%n"/>
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <!-- 控制台日志：开发时直接在终端查看。 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件日志：按天和大小滚动，避免单个日志文件无限增长。 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- dev 环境下打开项目包 DEBUG，便于查看 BaseController 的调试日志。 -->
    <springProfile name="dev">
        <logger name="com.mvp" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- prod 环境下收敛日志量，只保留 INFO 及以上。 -->
    <springProfile name="prod">
        <logger name="com.mvp" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- 没有命中 profile 时使用默认配置。 -->
    <springProfile name="!dev &amp; !prod">
        <logger name="com.mvp" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
</configuration>
